{
  "name": "citehop-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
